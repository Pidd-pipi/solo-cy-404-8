{
  "name": "smart-resume-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "preview": "vite preview --host 0.0.0.0",
    "test:dom": "vitest run --config vitest.config.ts",
    "test:dom:watch": "vitest --config vitest.config.ts",
    "test:browser": "bash scripts/setup-browser-env.sh && playwright test --config playwright.config.ts",
    "test:browser:install": "playwright install chromium",
    "test:browser:setup": "playwright install chromium && bash scripts/setup-browser-env.sh",
    "test:e2e": "npm run test:dom && npm run test:browser"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "dayjs": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.3",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.41",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
